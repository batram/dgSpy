<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HookLab.Watcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\HookLab\HookLab.Injector\HookLab.Injector.csproj" />
    <ProjectReference Include="..\..\HookLab\HookLab.Packaging\HookLab.Packaging.csproj" />
    <ProjectReference Include="..\..\HookLab\HookLab.Contracts\HookLab.Contracts.csproj" />
    <ProjectReference Include="..\..\HookLab\HookLab.Host.Transport\HookLab.Host.Transport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The watcher directly executes ProbeDiscoveryStore's DPAPI path. Keep the runtime asset explicit:
         an executable project reference did not propagate this transport package into the watcher layout. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HookLab.Watcher.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="deployments\**\*.cs" />
  </ItemGroup>
</Project>
