<UserControl x:Class="dgSpy.Extension.ToolWindows.McpActivityControl"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- dnSpy has no theme brush for error text: ColorType.Error is a text-classification colour
             with no WPF resource key, and CommonControlsTextBoxErrorForeground is the foreground for
             text *on* a red field (near-white under the dark theme). Hence a literal, picked to read
             against GridViewBackground under both the dark and light themes. -->
        <SolidColorBrush x:Key="dgSpyActivityFailed" Color="#C05050" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" MinHeight="0" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Background="{DynamicResource EnvironmentCommandBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="3" Padding="8 1" Focusable="False" Content="_Clear" Command="{Binding ClearCommand}"
                    ToolTip="Discard every recorded MCP call" />
            <CheckBox Grid.Column="1" Margin="6 0" VerticalAlignment="Center" Content="_Auto scroll" IsChecked="{Binding AutoScroll}" />
            <Label Grid.Column="2" Margin="6 0 0 0" VerticalAlignment="Center" Content="_Search:" Target="{Binding ElementName=searchTextBox}" />
            <TextBox Grid.Column="3" Name="searchTextBox" Margin="3" VerticalAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter on operation, status, parameters or result" />
            <!-- Label, not TextBlock: dnSpy themes Label, and a bare TextBlock inherits WPF's default
                 black, which is unreadable on every dark theme. Same reason below. -->
            <Label Grid.Column="4" Margin="0 0 3 0" VerticalAlignment="Center" Content="{Binding CountText}" />
        </Grid>

        <!-- Call list -->
        <ListView Grid.Row="1"
                  Name="listView"
                  BorderThickness="0"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="#" Width="46" DisplayMemberBinding="{Binding Sequence}" />
                    <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}" />
                    <GridViewColumn Header="Operation" Width="170" DisplayMemberBinding="{Binding Operation}" />
                    <GridViewColumn Header="Status" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource dgSpyActivityFailed}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Duration" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Duration}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Parameters" Width="360" DisplayMemberBinding="{Binding ArgumentsSummary}" />
                    <GridViewColumn Header="Result" Width="360" DisplayMemberBinding="{Binding ResultSummary}" />
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource EnvironmentCommandBar}" ResizeBehavior="PreviousAndNext" />

        <!-- Details for the selected call -->
        <Grid Grid.Row="3" Background="{DynamicResource GridViewBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="6 3" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource GridViewListViewForeground}"
                       Text="{Binding SelectedHeader}" />
            <!-- dnSpy's GroupBox style themes the border but not the header, which therefore inherits
                 WPF's default black. dnSpy only uses GroupBox inside option-page dialogs that already
                 set a foreground higher up; a tool window has to set it here. -->
            <GroupBox Grid.Row="1" Grid.Column="0" Margin="3" Header="Parameters"
                      Foreground="{DynamicResource GridViewListViewForeground}">
                <TextBox Text="{Binding SelectedArguments, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="Transparent" />
            </GroupBox>
            <GroupBox Grid.Row="1" Grid.Column="1" Margin="3" Header="Result"
                      Foreground="{DynamicResource GridViewListViewForeground}">
                <TextBox Text="{Binding SelectedResult, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="Transparent" />
            </GroupBox>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource GridViewListViewForeground}"
                       Text="Select a call to see its full parameters and result.">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
