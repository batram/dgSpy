<Project DefaultTargets="Build">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>
	<Target Name="ValidateHostContractInput" BeforeTargets="Restore;Build">
		<Error Condition="'$(DgSpyHostContractsRoot)' == ''" Text="DgSpyHostContractsRoot must name the immutable host-raw bin directory." />
		<Error Condition="!Exists('$(DgSpyHostContractsRoot)\dnSpy.Contracts.DnSpy.dll')" Text="DgSpyHostContractsRoot does not contain dnSpy.Contracts.DnSpy.dll: $(DgSpyHostContractsRoot)" />
	</Target>
  <ItemGroup>
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\dgSpy.Protocol\dgSpy.Protocol.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\dgSpy.ExtensionContracts\dgSpy.ExtensionContracts.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\HookLab\HookLab.Contracts\HookLab.Contracts.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\HookLab\HookLab.Packaging\HookLab.Packaging.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\HookLab\HookLab.Probe.CorDebug\HookLab.Probe.CorDebug.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\HookLab\HookLab.Host.Transport\HookLab.Host.Transport.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\HookLab\HookLab.Bootstrap\HookLab.Bootstrap.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\HookLab\HookLab.Injector\HookLab.Injector.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\tools\HookLab.Watcher\HookLab.Watcher.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\tools\HookLab.Watcher.Companion\HookLab.Watcher.Companion.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\dgSpy.Gateway\dgSpy.Gateway.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)..\dgSpy.Cli\dgSpy.Cli.csproj" />
    <ComponentProject Include="$(MSBuildThisFileDirectory)DgSpyTool\DgSpyTool.csproj" />
  </ItemGroup>
  <Target Name="Restore">
    <MSBuild Projects="@(ComponentProject);$(MSBuildThisFileDirectory)..\Extensions\dgSpy.Extension\dgSpy.Extension.csproj"
             Targets="Restore" BuildInParallel="true"
			 Properties="Configuration=$(Configuration);DgSpyHostContractsRoot=$(DgSpyHostContractsRoot)" />
  </Target>
  <!-- No DependsOnTargets="Restore": restore must run in its own evaluation pass (the /restore
       switch), or projects evaluated before NuGet writes their assets keep the empty evaluation
       and compile with no references at all (CS0518 on a fresh checkout). -->
  <Target Name="Build">
    <MSBuild Projects="@(ComponentProject)" Targets="Build" BuildInParallel="true"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Extensions\dgSpy.Extension\dgSpy.Extension.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows;DgSpyHostContractsRoot=$(DgSpyHostContractsRoot)" />
  </Target>
</Project>
