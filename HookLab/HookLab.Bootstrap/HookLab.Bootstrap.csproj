<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HookLab.Bootstrap</AssemblyName>
    <!-- The bootstrap ships as one file. Everything it needs travels inside it as hash-verified bytes,
         so nothing may be copied next to it: a loose payload DLL beside the bootstrap is a disk
         provenance the resolver is specifically built to forbid. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Private="false" keeps these out of this project's output; PrivateAssets="all" stops them flowing
         to whatever references the bootstrap. Both are required. Without the second, a consumer copies the
         payloads next to itself as transitive references, the CLR binds them from disk before
         AssemblyResolve is ever raised, and the resolver silently stops being the thing under test.
         The host transport assembly must never appear here: it source-links the probe's wire codec, so
         anything referencing both gets CS0433 on ProbeWireProtocol/ProbeAuthentication. -->
    <ProjectReference Include="..\HookLab.Contracts\HookLab.Contracts.csproj" Private="false" PrivateAssets="all" />
    <ProjectReference Include="..\HookLab.Probe.CorDebug\HookLab.Probe.CorDebug.csproj" Private="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HookLab.Bootstrap.Tests" />
  </ItemGroup>

  <!-- Reference assemblies only: never compiled against, never shipped. They are the pinned, hashed
       source of "which .NET Framework assembly really defines this type", which is what the netstandard
       retarget below needs and what it must not read off the machine. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <RetargetTool>$(MSBuildThisFileDirectory)..\..\Build\RetargetNetstandardReferences\RetargetNetstandardReferences.csproj</RetargetTool>
    <NetFxReferenceAssemblies>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8</NetFxReferenceAssemblies>
    <!-- The assemblies a rewritten reference may point at: exactly the ones a stripped Unity player's
         nine-assembly Managed directory contains, which is the smallest set any supported target has.
         Anything else becomes a placeholder in the generated compatibility assembly below. -->
    <NetFxRetargetAllowed>mscorlib,System,System.Core,System.Xml,System.Numerics</NetFxRetargetAllowed>
    <!-- Where placeholder shapes are read from - base types, sealedness, enum-ness - so a placeholder for
         an attribute still derives from System.Attribute. Reference assemblies only; nothing is shipped
         from them. A netstandard type whose home is outside both lists fails the build by name. -->
    <NetFxRetargetPlaceholderSources>System.Xml.Linq,System.Runtime.Serialization</NetFxRetargetPlaceholderSources>
    <HookLabCompatAssembly>HookLab.Compat</HookLabCompatAssembly>
    <RoslynCommonSource>$(NuGetPackageRoot)microsoft.codeanalysis.common\5.6.0\lib\netstandard2.0\Microsoft.CodeAnalysis.dll</RoslynCommonSource>
    <RoslynCSharpSource>$(NuGetPackageRoot)microsoft.codeanalysis.csharp\5.6.0\lib\netstandard2.0\Microsoft.CodeAnalysis.CSharp.dll</RoslynCSharpSource>
  </PropertyGroup>

  <!-- Removes the one payload requirement that cannot be shipped.

       A payload compiled for netstandard2.0 references netstandard, Version=2.0.0.0, PublicKeyToken=
       cc7b13ffcd2ddd51 and cannot load without it. A shipped Unity player has no Facades directory and
       therefore no netstandard, and the reference cannot be satisfied by anything dgSpy builds: it is
       strong-named to Microsoft's key, so a generated type-forward facade is useless, and taking a copy
       off a machine is exactly the disk provenance the resolver exists to forbid. Roslyn 5.6.0 offers no
       way out either - everything that is not .NET Core is netstandard2.0, and the last net45 build was
       Roslyn 1.0, which is C# 6 from 2015.

       So the reference is deleted rather than satisfied: every [netstandard]Type typeref is rewritten to
       the .NET Framework assembly that really defines the type, read out of the pinned reference-assembly
       package above. Assembly identity - including Microsoft's public key on Roslyn - is untouched, so
       nothing that binds to these payloads had to learn anything; only the digest and the provenance
       change, and DgSpyTool proves both against the shipped bytes and refuses any bootstrap payload that
       still names netstandard.

       All three payloads that need it, not only Roslyn: HookLab.Contracts is dgSpy's own netstandard2.0
       assembly and referenced the facade for exactly the same reason. The probe is net48 and needs
       nothing. The compiler-support facades are net462 builds and never referenced it.

       The tool is built here rather than assumed: HookLab.Bootstrap must build on its own, and a
       checked-in binary would be a payload input nobody could review. RemoveProperties keeps this net48
       build's TargetFramework out of the net10 tool's. -->
  <Target Name="RetargetPayloadNetstandardReferences" DependsOnTargets="ResolveReferences" BeforeTargets="EmbedBootstrapPayloads">
    <Error Condition="!Exists('$(NetFxReferenceAssemblies)')" Text="The pinned .NET Framework 4.8 reference assemblies are missing at '$(NetFxReferenceAssemblies)'. Restore Microsoft.NETFramework.ReferenceAssemblies.net48." />
    <!-- Set here rather than in a project-level PropertyGroup: IntermediateOutputPath is computed by the
         common targets, which run after this project's body is evaluated, so up there it is empty and the
         retargeted payloads land in the source tree. A target PropertyGroup persists for the rest of the
         build, so EmbedBootstrapPayloads - which this runs before - sees the same value. -->
    <PropertyGroup>
      <RetargetDirectory>$(IntermediateOutputPath)retargeted\</RetargetDirectory>
    </PropertyGroup>
    <ItemGroup>
      <RetargetPayload Include="@(ReferencePath)" Condition="'%(Filename)' == 'HookLab.Contracts'" />
      <RetargetPayload Include="$(RoslynCommonSource)" />
      <RetargetPayload Include="$(RoslynCSharpSource)" />
    </ItemGroup>
    <Error Condition="'@(RetargetPayload->Count())' != '3'" Text="Expected three payloads to retarget, resolved: @(RetargetPayload->'%(Filename)')" />
    <MSBuild Projects="$(RetargetTool)" Targets="Restore;Build" Properties="Configuration=Release"
             RemoveProperties="TargetFramework;TargetFrameworks;Platform;PlatformTarget;RuntimeIdentifier;OutputPath;IntermediateOutputPath">
      <Output TaskParameter="TargetOutputs" ItemName="_RetargetTool" />
    </MSBuild>
    <!-- One invocation for all three, not one each: a single generated compatibility assembly serves
         every rewritten payload, so its contents have to be decided before any of them is written. -->
    <Exec Command="dotnet &quot;@(_RetargetTool->'%(FullPath)')&quot; --reference-assemblies &quot;$(NetFxReferenceAssemblies)&quot; --allow $(NetFxRetargetAllowed) --compat-assembly $(HookLabCompatAssembly) --placeholders-from $(NetFxRetargetPlaceholderSources) --output-directory &quot;$(RetargetDirectory).&quot; @(RetargetPayload->'--input &quot;%(FullPath)&quot;', ' ')" />
    <ItemGroup>
      <FileWrites Include="$(RetargetDirectory)*.dll" />
    </ItemGroup>
  </Target>

  <!-- Copies T04's proven embedding shape: the payload never exists as a loose file, and its digest is
       pinned at build time rather than computed from whatever happens to be on disk at load time.
       This has to land before AssignTargetPaths, not before PrepareResources: a target's DependsOnTargets
       run ahead of its BeforeTargets, so by the time anything hooked to PrepareResources fires,
       PrepareResourceNames has already split the resource items and a late addition is silently dropped -
       the assembly builds clean and ships with no payload at all. -->
  <Target Name="EmbedBootstrapPayloads" DependsOnTargets="ResolveReferences" BeforeTargets="AssignTargetPaths">
    <!-- One declaration per resident payload, and the only place the runtime/architecture/framework/
         provenance/identity facts are stated. Everything downstream - what gets embedded, what the
         resident resolver serves, what the packaging tool verifies - is derived from these rows, so a
         payload cannot ship without also being described. The digests are generated below from the exact
         files resolved here; the identities are pinned, and DgSpyTool proves the pins against the bytes.

         PayloadId/Asm* metadata names are deliberately un-reserved: Identity, Filename and Version are
         well-known item metadata and assigning them here would either fail or silently mean something
         else. Carrier says which assembly holds the bytes - the two Harmony assets live inside the probe,
         which is why they were previously described nowhere at all. -->
    <ItemGroup>
      <PayloadMatrixEntry Include="$(RetargetDirectory)HookLab.Contracts.dll">
        <PayloadId>HookLab.Contracts</PayloadId><Role>contracts</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.HookLab.Contracts.dll</ResourceName>
        <Tfm>net48</Tfm><Arch>any</Arch><Runtimes>clrv4,coreclr,mono</Runtimes>
        <AsmName>HookLab.Contracts</AsmName><AsmVersion>1.0.0.0</AsmVersion><AsmToken>none</AsmToken>
        <Provenance>build:RetargetNetstandardReferences(project:HookLab/HookLab.Contracts)</Provenance><Requires></Requires>
      </PayloadMatrixEntry>
      <PayloadMatrixEntry Include="@(ReferencePath)" Condition="'%(Filename)' == 'HookLab.Probe.CorDebug'">
        <PayloadId>HookLab.Probe.CorDebug</PayloadId><Role>resident</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.HookLab.Probe.CorDebug.dll</ResourceName>
        <Tfm>net48</Tfm><Arch>x64</Arch><Runtimes>clrv4,coreclr,mono</Runtimes>
        <AsmName>HookLab.Probe.CorDebug</AsmName><AsmVersion>1.0.0.0</AsmVersion><AsmToken>none</AsmToken>
        <Provenance>project:HookLab/HookLab.Probe.CorDebug</Provenance>
        <Requires>HookLab.Contracts,Microsoft.CodeAnalysis.CSharp,Harmony.Desktop,Harmony.CoreClr</Requires>
      </PayloadMatrixEntry>
      <!-- The retargeted Roslyn, not the package's own bytes - see RetargetRoslynPayloads above. The
           target framework is stated as net48 because that is what these bytes now are: netstandard2.0 is
           a compile-time contract, and an assembly that no longer references netstandard is not one.
           Identity is unchanged, so nothing that binds to Roslyn had to learn anything. -->
      <PayloadMatrixEntry Include="$(RetargetDirectory)Microsoft.CodeAnalysis.dll">
        <PayloadId>Microsoft.CodeAnalysis</PayloadId><Role>compiler</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.Microsoft.CodeAnalysis.dll</ResourceName>
        <Tfm>net48</Tfm><Arch>any</Arch><Runtimes>clrv4,coreclr,mono</Runtimes>
        <AsmName>Microsoft.CodeAnalysis</AsmName><AsmVersion>5.6.0.0</AsmVersion><AsmToken>31bf3856ad364e35</AsmToken>
        <Provenance>build:RetargetNetstandardReferences(nuget:microsoft.codeanalysis.common/5.6.0)</Provenance>
        <Requires>System.Collections.Immutable,System.Runtime.CompilerServices.Unsafe,HookLab.Compat</Requires>
      </PayloadMatrixEntry>
      <PayloadMatrixEntry Include="$(RetargetDirectory)Microsoft.CodeAnalysis.CSharp.dll">
        <PayloadId>Microsoft.CodeAnalysis.CSharp</PayloadId><Role>compiler</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.Microsoft.CodeAnalysis.CSharp.dll</ResourceName>
        <Tfm>net48</Tfm><Arch>any</Arch><Runtimes>clrv4,coreclr,mono</Runtimes>
        <AsmName>Microsoft.CodeAnalysis.CSharp</AsmName><AsmVersion>5.6.0.0</AsmVersion><AsmToken>31bf3856ad364e35</AsmToken>
        <Provenance>build:RetargetNetstandardReferences(nuget:microsoft.codeanalysis.csharp/5.6.0)</Provenance>
        <Requires>Microsoft.CodeAnalysis,System.Collections.Immutable,System.Runtime.CompilerServices.Unsafe</Requires>
      </PayloadMatrixEntry>
      <!-- Placeholder definitions for the types no supported target ships, and the reason a compile can
           happen inside a stripped Unity player at all.

           Mono resolves a type's base type and field types when it *prepares* the type. Roslyn's ordinary
           Emit path prepares DocumentationCommentCompiler, whose _includedFileCache field is a
           DocumentationCommentIncludeCache, whose base type mentions System.Xml.Linq.XDocument - and a
           player has no System.Xml.Linq. Measured 2026-08-21 against a live player: TypeLoadException,
           over a cache the compile never reads. CLR v4 resolves lazily and never noticed.

           These types exist to be found, not to work: no members, so the method bodies that would use
           them fail loudly at the call if that assumption is ever wrong, instead of answering wrongly.
           The build prints every placeholder it emits, so the set cannot grow unnoticed. -->
      <PayloadMatrixEntry Include="$(RetargetDirectory)$(HookLabCompatAssembly).dll">
        <PayloadId>HookLab.Compat</PayloadId><Role>compiler-support</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.HookLab.Compat.dll</ResourceName>
        <Tfm>net48</Tfm><Arch>any</Arch><Runtimes>clrv4,coreclr,mono</Runtimes>
        <AsmName>HookLab.Compat</AsmName><AsmVersion>1.0.0.0</AsmVersion><AsmToken>none</AsmToken>
        <Provenance>build:RetargetNetstandardReferences(nuget:microsoft.netframework.referenceassemblies.net48/1.0.3)</Provenance><Requires></Requires>
      </PayloadMatrixEntry>
      <PayloadMatrixEntry Include="$(NuGetPackageRoot)system.collections.immutable\10.0.1\lib\net462\System.Collections.Immutable.dll">
        <PayloadId>System.Collections.Immutable</PayloadId><Role>compiler-support</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.System.Collections.Immutable.dll</ResourceName>
        <Tfm>net462</Tfm><Arch>any</Arch><Runtimes>clrv4,coreclr,mono</Runtimes>
        <AsmName>System.Collections.Immutable</AsmName><AsmVersion>10.0.0.1</AsmVersion><AsmToken>b03f5f7f11d50a3a</AsmToken>
        <Provenance>nuget:system.collections.immutable/10.0.1</Provenance>
        <Requires>System.Runtime.CompilerServices.Unsafe</Requires>
      </PayloadMatrixEntry>
      <!-- The two slots Unity needed, and only the two. CLR v4 compiles with CodeDom and never loads
           Roslyn at all, so nothing here was ever exercised on it; CoreCLR takes these from its shared
           framework, which is why they are deliberately not declared valid there - a payload the runtime
           already supplies loses the bind to it, and dependency_resolution refuses rather than shipping a
           second copy nobody asked for.

           Roslyn's remaining net4x dependencies - Numerics.Vectors, Threading.Tasks.Extensions,
           Text.Encoding.CodePages - are deliberately absent. Every Mono build measured supplies all three
           itself, and shipping them produced exactly the refusal above: the runtime's own copy wins the
           bind and the resident correctly refuses to pretend otherwise. A build that lacks one fails at
           dependency_resolution by name, which is a row to add with evidence rather than a mystery - and
           the Fallback column below is how it would be added without breaking the builds that have it. -->
      <PayloadMatrixEntry Include="$(NuGetPackageRoot)system.runtime.compilerservices.unsafe\6.1.2\lib\net462\System.Runtime.CompilerServices.Unsafe.dll">
        <PayloadId>System.Runtime.CompilerServices.Unsafe</PayloadId><Role>compiler-support</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.System.Runtime.CompilerServices.Unsafe.dll</ResourceName>
        <Tfm>net462</Tfm><Arch>any</Arch><Runtimes>clrv4,mono</Runtimes>
        <AsmName>System.Runtime.CompilerServices.Unsafe</AsmName><AsmVersion>6.0.3.0</AsmVersion><AsmToken>b03f5f7f11d50a3a</AsmToken>
        <Provenance>nuget:system.runtime.compilerservices.unsafe/6.1.2</Provenance><Requires></Requires>
      </PayloadMatrixEntry>
      <!-- The two fallback slots, and the reason the Fallback column exists at all.

           Roslyn needs System.Memory 4.0.5.0. mono-project's Mono 6.12 ships 4.0.1.1 in its own profile,
           which is older and does not satisfy the reference, and no System.Buffers at all - so on that
           build both of these have to be carried. The Mono a Unity 2021.3 player embeds supplies both at
           4.0.99.0 in lib/mono/unityjit-win32/Facades, and carrying them there is not a spare tyre but a
           second System.Memory in one AppDomain: ReadOnlySpan<T> becomes two distinct types and Roslyn
           cannot find its own ImmutableArray.Create overload any more.

           Neither build is wrong; "what the runtime lacks" is simply a property of a build rather than of
           a family, which is what a family flag cannot say. Declaring these mono rows as fallbacks moves
           the decision to where the answer exists - the target's own binder, asked for the exact declared
           identity before anything is byte-loaded - and the resident reports which copy answered.

           clrv4 is deliberately not a fallback family here even though the same argument would fit: .NET
           Framework 4.8 has neither facade, no target has ever been measured supplying one, and the CLR v4
           leg must not acquire a conditional on an unmeasured hypothesis. coreclr does not declare these
           rows at all - its shared framework supplies them, so they were never carried there. -->
      <PayloadMatrixEntry Include="$(NuGetPackageRoot)system.memory\4.6.3\lib\net462\System.Memory.dll">
        <PayloadId>System.Memory</PayloadId><Role>compiler-support</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.System.Memory.dll</ResourceName>
        <Tfm>net462</Tfm><Arch>any</Arch><Runtimes>clrv4,mono</Runtimes><Fallback>mono</Fallback>
        <AsmName>System.Memory</AsmName><AsmVersion>4.0.5.0</AsmVersion><AsmToken>cc7b13ffcd2ddd51</AsmToken>
        <Provenance>nuget:system.memory/4.6.3</Provenance>
        <Requires>System.Buffers,System.Runtime.CompilerServices.Unsafe</Requires>
      </PayloadMatrixEntry>
      <PayloadMatrixEntry Include="$(NuGetPackageRoot)system.buffers\4.6.1\lib\net462\System.Buffers.dll">
        <PayloadId>System.Buffers</PayloadId><Role>compiler-support</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.System.Buffers.dll</ResourceName>
        <Tfm>net462</Tfm><Arch>any</Arch><Runtimes>clrv4,mono</Runtimes><Fallback>mono</Fallback>
        <AsmName>System.Buffers</AsmName><AsmVersion>4.0.5.0</AsmVersion><AsmToken>cc7b13ffcd2ddd51</AsmToken>
        <Provenance>nuget:system.buffers/4.6.1</Provenance><Requires></Requires>
      </PayloadMatrixEntry>
      <!-- The three facades a *shipped* Unity player turns out to lack, added with the evidence the
           comment above asked for.

           Measured 2026-08-21 against a real uch-debug-target player: a player's Managed directory holds
           nine non-Unity assemblies - mscorlib, System, System.Core, System.Xml, System.Numerics,
           System.Configuration, System.Security, Mono.Security, Assembly-CSharp - and no Facades
           directory at all. Unity ships only what the game references. That is a strictly smaller set
           than the editor's unityjit-win32 profile, which does have Facades, so every earlier "Unity"
           measurement was taken against a richer runtime than any player has.

           Fallback on mono for the same reason System.Memory is: mono-project 6.12 and the editor
           profile supply all three, and deferring to a runtime's own copy is what keeps one of each in
           the process. Not declared on clrv4 or coreclr, which supply them and never reach these rows. -->
      <PayloadMatrixEntry Include="$(NuGetPackageRoot)system.numerics.vectors\4.6.1\lib\net462\System.Numerics.Vectors.dll">
        <PayloadId>System.Numerics.Vectors</PayloadId><Role>compiler-support</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.System.Numerics.Vectors.dll</ResourceName>
        <Tfm>net462</Tfm><Arch>any</Arch><Runtimes>mono</Runtimes><Fallback>mono</Fallback>
        <AsmName>System.Numerics.Vectors</AsmName><AsmVersion>4.1.6.0</AsmVersion><AsmToken>b03f5f7f11d50a3a</AsmToken>
        <Provenance>nuget:system.numerics.vectors/4.6.1</Provenance><Requires></Requires>
      </PayloadMatrixEntry>
      <PayloadMatrixEntry Include="$(NuGetPackageRoot)system.threading.tasks.extensions\4.6.3\lib\net462\System.Threading.Tasks.Extensions.dll">
        <PayloadId>System.Threading.Tasks.Extensions</PayloadId><Role>compiler-support</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.System.Threading.Tasks.Extensions.dll</ResourceName>
        <Tfm>net462</Tfm><Arch>any</Arch><Runtimes>mono</Runtimes><Fallback>mono</Fallback>
        <AsmName>System.Threading.Tasks.Extensions</AsmName><AsmVersion>4.2.4.0</AsmVersion><AsmToken>cc7b13ffcd2ddd51</AsmToken>
        <Provenance>nuget:system.threading.tasks.extensions/4.6.3</Provenance>
        <Requires>System.Runtime.CompilerServices.Unsafe</Requires>
      </PayloadMatrixEntry>
      <PayloadMatrixEntry Include="$(NuGetPackageRoot)system.text.encoding.codepages\8.0.0\lib\net462\System.Text.Encoding.CodePages.dll">
        <PayloadId>System.Text.Encoding.CodePages</PayloadId><Role>compiler-support</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.System.Text.Encoding.CodePages.dll</ResourceName>
        <Tfm>net462</Tfm><Arch>any</Arch><Runtimes>mono</Runtimes><Fallback>mono</Fallback>
        <AsmName>System.Text.Encoding.CodePages</AsmName><AsmVersion>8.0.0.0</AsmVersion><AsmToken>b03f5f7f11d50a3a</AsmToken>
        <Provenance>nuget:system.text.encoding.codepages/8.0.0</Provenance>
        <Requires>System.Memory,System.Runtime.CompilerServices.Unsafe</Requires>
      </PayloadMatrixEntry>
      <PayloadMatrixEntry Include="$(NuGetPackageRoot)system.reflection.metadata\10.0.1\lib\net462\System.Reflection.Metadata.dll">
        <PayloadId>System.Reflection.Metadata</PayloadId><Role>compiler-support</Role><Carrier>bootstrap</Carrier>
        <ResourceName>HookLab.Bootstrap.Payloads.System.Reflection.Metadata.dll</ResourceName>
        <Tfm>net462</Tfm><Arch>any</Arch><Runtimes>clrv4,mono</Runtimes>
        <AsmName>System.Reflection.Metadata</AsmName><AsmVersion>10.0.0.1</AsmVersion><AsmToken>b03f5f7f11d50a3a</AsmToken>
        <Provenance>nuget:system.reflection.metadata/10.0.1</Provenance>
        <Requires>System.Collections.Immutable,System.Memory</Requires>
      </PayloadMatrixEntry>
      <!-- Carried by the probe, not by this assembly: the probe extracts exactly one of these by corlib
           name. They are hashed and described here so that the shipped set of resident bytes is complete
           in one artifact, and DgSpyTool reads them back out of the probe payload to prove it. -->
      <PayloadMatrixEntry Include="$(NuGetPackageRoot)lib.harmony\2.4.2\lib\net48\0Harmony.dll">
        <PayloadId>Harmony.Desktop</PayloadId><Role>patch-engine</Role><Carrier>probe</Carrier>
        <ResourceName>HookLab.Probe.CorDebug.Backends.Desktop.0Harmony.dll</ResourceName>
        <Tfm>net48</Tfm><Arch>any</Arch><Runtimes>clrv4,mono</Runtimes>
        <AsmName>0Harmony</AsmName><AsmVersion>2.4.2.0</AsmVersion><AsmToken>none</AsmToken>
        <Provenance>nuget:lib.harmony/2.4.2</Provenance><Requires></Requires>
      </PayloadMatrixEntry>
      <PayloadMatrixEntry Include="$(NuGetPackageRoot)lib.harmony\2.4.2\lib\net6.0\0Harmony.dll">
        <PayloadId>Harmony.CoreClr</PayloadId><Role>patch-engine</Role><Carrier>probe</Carrier>
        <ResourceName>HookLab.Probe.CorDebug.Backends.CoreClr.0Harmony.dll</ResourceName>
        <Tfm>net6.0</Tfm><Arch>any</Arch><Runtimes>coreclr</Runtimes>
        <AsmName>0Harmony</AsmName><AsmVersion>2.4.2.0</AsmVersion><AsmToken>none</AsmToken>
        <Provenance>nuget:lib.harmony/2.4.2</Provenance><Requires></Requires>
      </PayloadMatrixEntry>
    </ItemGroup>
    <PropertyGroup>
      <BootstrapPayloadNames>@(PayloadMatrixEntry->'%(PayloadId)')</BootstrapPayloadNames>
    </PropertyGroup>
    <Error Condition="!$(BootstrapPayloadNames.Contains('HookLab.Contracts'))" Text="HookLab.Contracts was not resolved, so the bootstrap would ship without it. Resolved: $(BootstrapPayloadNames)" />
    <Error Condition="!$(BootstrapPayloadNames.Contains('HookLab.Probe.CorDebug'))" Text="HookLab.Probe.CorDebug was not resolved, so the bootstrap would ship without it. Resolved: $(BootstrapPayloadNames)" />
    <Error Condition="!$(BootstrapPayloadNames.Contains('Microsoft.CodeAnalysis')) Or !$(BootstrapPayloadNames.Contains('Microsoft.CodeAnalysis.CSharp'))" Text="Roslyn was not resolved, so compiled hooks would fail in CoreCLR targets. Resolved: $(BootstrapPayloadNames)" />
    <Error Condition="!Exists('%(PayloadMatrixEntry.FullPath)')" Text="Payload matrix slot '%(PayloadMatrixEntry.PayloadId)' has no file at %(PayloadMatrixEntry.FullPath)." />
    <GetFileHash Files="@(PayloadMatrixEntry)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="PayloadMatrixHashed" />
    </GetFileHash>
    <ItemGroup>
      <PayloadMatrixLine Include="hooklab-payload-matrix|4" />
      <PayloadMatrixLine Include="@(PayloadMatrixHashed->'%(PayloadId)|%(Role)|%(Carrier)|%(ResourceName)|%(Tfm)|%(Arch)|%(Runtimes)|%(Fallback)|%(AsmName)|%(AsmVersion)|%(AsmToken)|%(Provenance)|%(Requires)|%(FileHash)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)hooklab-payload-matrix.txt"
                      Lines="@(PayloadMatrixLine)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="@(PayloadMatrixHashed)" Condition="'%(Carrier)' == 'bootstrap'">
        <LogicalName>%(ResourceName)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(IntermediateOutputPath)hooklab-payload-matrix.txt">
        <LogicalName>HookLab.Bootstrap.Payloads.matrix.txt</LogicalName>
      </EmbeddedResource>
      <FileWrites Include="$(IntermediateOutputPath)hooklab-payload-matrix.txt" />
    </ItemGroup>
  </Target>
</Project>
