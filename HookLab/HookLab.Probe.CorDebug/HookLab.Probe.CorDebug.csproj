<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HookLab.Probe.CorDebug</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The transport harness needs a seam inside ProbePipeServer.Serve: the dispatch-admission race lives
         between decoding a request and admitting it, and nothing outside the class can hold a listener there. -->
    <InternalsVisibleTo Include="HookLab.Transport.Harness" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" GeneratePathProperty="true" ExcludeAssets="runtime" />
	<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <!-- Restored here, embedded by HookLab.Bootstrap, referenced by neither: ExcludeAssets="all" keeps
         them out of the compile and the output. They are the two Roslyn dependencies a Unity target has to
         be handed - CoreCLR has them in its shared framework and CLR v4 never loads Roslyn - and they are
         pinned by hand so a fresh clone cannot resolve a version the payload matrix does not describe.
         The bootstrap cannot declare them itself: it takes no package dependency at all, by design and by
         test, so the restore has to happen on this side of the project reference. -->
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Reflection.Metadata" Version="10.0.1" ExcludeAssets="all" PrivateAssets="all" />
    <ProjectReference Include="..\HookLab.Contracts\HookLab.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PkgLib_Harmony)\lib\net48\0Harmony.dll" LogicalName="HookLab.Probe.CorDebug.Backends.Desktop.0Harmony.dll" />
    <EmbeddedResource Include="$(PkgLib_Harmony)\lib\net6.0\0Harmony.dll" LogicalName="HookLab.Probe.CorDebug.Backends.CoreClr.0Harmony.dll" />
  </ItemGroup>
</Project>
