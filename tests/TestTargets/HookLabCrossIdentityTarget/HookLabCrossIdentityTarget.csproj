<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <AssemblyName>HookLabCrossIdentityTarget</AssemblyName>
    <RootNamespace>HookLabCrossIdentityTarget</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Referenced so the build copies it next to the executable, but deliberately NOT used from the
         default domain: Program loads it by name into the domain it creates. -->
    <ProjectReference Include="..\HookLabCrossIdentityWork\HookLabCrossIdentityWork.csproj" />
  </ItemGroup>
</Project>
