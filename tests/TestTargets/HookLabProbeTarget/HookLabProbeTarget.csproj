<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- One fixture, both runtime families. The compatibility probe's whole point is that the same
         resident payload has to work on each, so the target it works on must be the same program
         rather than two that happen to look alike. -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Unoptimized so Tick keeps a stable, guardable body: the probe guards on its exact IL digest,
         and an optimized build is free to reshape it. -->
    <Optimize>false</Optimize>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>HookLabProbeTarget</AssemblyName>
    <RootNamespace>HookLabProbeTarget</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HookLabProbeDomain\HookLabProbeDomain.csproj" />
  </ItemGroup>
</Project>
