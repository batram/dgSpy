<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Portable, and unoptimised: the soft debugger places a breakpoint at an IL offset only where it
         has a sequence point, and an optimised build is entitled not to have one at the offset a caller
         names. Every other HookLab fixture in this tree makes the same two choices for the same reason. -->
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <AssemblyName>MonoHookLabTarget</AssemblyName>
    <RootNamespace>MonoHookLabTarget</RootNamespace>
  </PropertyGroup>
</Project>
