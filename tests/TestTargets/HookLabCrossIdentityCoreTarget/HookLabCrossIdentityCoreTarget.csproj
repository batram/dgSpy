<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>portable</DebugType>
    <!-- Unoptimized so the hooked method keeps a stable, guardable body: the smoke asserts on its exact
         IL digest, and an optimized build is free to reshape Tick. -->
    <Optimize>false</Optimize>
    <Nullable>enable</Nullable>
    <AssemblyName>HookLabCrossIdentityCoreTarget</AssemblyName>
  </PropertyGroup>
</Project>
