<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.3" />
    <PackageReference Include="xunit" Version="2.5.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.0" />
    <!-- Three payload-resolver cases assert against REAL host layouts - a packed install, a Gateway
         deployment, a build worktree - because a fixture-only test passes while the layout that
         launch_local_host actually produces is broken. That evidence is worth having and it cannot
         exist on a fresh CI runner. xunit 2.5 has no dynamic skip, so these report Skipped rather
         than silently passing, which is the failure mode this suite exists to avoid. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Extensions\dgSpy.Extension\Identity\ProgramIdentity.cs" Link="Identity\ProgramIdentity.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\SessionStateCalculator.cs" Link="Debugger\SessionStateCalculator.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\FrameSnapshotGuard.cs" Link="Debugger\FrameSnapshotGuard.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\DetachCompletionGuard.cs" Link="Debugger\DetachCompletionGuard.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\LaunchSessionOwnership.cs" Link="Debugger\LaunchSessionOwnership.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\BreakpointSnapPolicy.cs" Link="Debugger\BreakpointSnapPolicy.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\OwnedBreakpoints\OwnedBreakpointStopLabel.cs" Link="Debugger\OwnedBreakpoints\OwnedBreakpointStopLabel.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\ActionLeaseCoordinator.cs" Link="Debugger\ActionLeaseCoordinator.cs" />
    <!-- Deliberately dnSpy-free: it carries the capture-then-recheck decision that closes the lease
         check-to-dispatch race, so it can be exercised here against the real coordinator and the real
         debugger dispatcher rather than a stand-in for either. -->
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\ActionLeaseAuthorization.cs" Link="Debugger\ActionLeaseAuthorization.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\AtomicActions\AtomicActionModels.cs" Link="Debugger\AtomicActions\AtomicActionModels.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\AtomicActions\AtomicActionAbstractions.cs" Link="Debugger\AtomicActions\AtomicActionAbstractions.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\AtomicActions\AtomicActionStateMachine.cs" Link="Debugger\AtomicActions\AtomicActionStateMachine.cs" />
    <!-- The dnSpy-facing half of an atomic action, kept dnSpy-free precisely so it can be reached from
         here: RpcHost.AtomicActions.cs is a partial of a class no test can construct, and every decision
         that used to be inlined in it shipped uncovered. -->
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\AtomicActions\AtomicActionHostSupport.cs" Link="Debugger\AtomicActions\AtomicActionHostSupport.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\AtomicActions\AtomicActionRecordStore.cs" Link="Debugger\AtomicActions\AtomicActionRecordStore.cs" />
    <!-- T08c. The asynchronous shape and the typed blocker are both here rather than in
         RpcHost.AtomicActions.cs for the reason above: the scheduler owns "start returns after
         registration, not after arming", and the probe owns "a failed probe is not evidence of a safe
         point" - neither is testable from a partial of a class no test can construct. -->
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\AtomicActions\AtomicActionScheduler.cs" Link="Debugger\AtomicActions\AtomicActionScheduler.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Debugger\AtomicActions\EvaluationProbe.cs" Link="Debugger\AtomicActions\EvaluationProbe.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Rpc\RpcException.cs" Link="Rpc\RpcException.cs" />
	<Compile Include="..\..\Extensions\dgSpy.Extension\Rpc\RpcSecurity.cs" Link="Rpc\RpcSecurity.cs" />
	<Compile Include="..\..\Extensions\dgSpy.Extension\Decompiler\SymbolSearchQuery.cs" Link="Decompiler\SymbolSearchQuery.cs" />
	<Compile Include="..\..\Extensions\dgSpy.Extension\Decompiler\ModuleNameMatch.cs" Link="Decompiler\ModuleNameMatch.cs" />
	<Compile Include="..\..\Extensions\dgSpy.Extension\Decompiler\ModuleInstanceId.cs" Link="Decompiler\ModuleInstanceId.cs" />
	<Compile Include="..\..\Extensions\dgSpy.Extension\Decompiler\ScanCursor.cs" Link="Decompiler\ScanCursor.cs" />
	<Compile Include="..\..\Extensions\dgSpy.Extension\Evaluation\MemberPagination.cs" Link="Evaluation\MemberPagination.cs" />
	<Compile Include="..\..\Extensions\dgSpy.Extension\Evaluation\ChildExpansionFailure.cs" Link="Evaluation\ChildExpansionFailure.cs" />
	<Compile Include="..\..\Extensions\dgSpy.Extension\Evaluation\ExpressionAddressability.cs" Link="Evaluation\ExpressionAddressability.cs" />
	<Compile Include="..\..\Extensions\dgSpy.Extension\Evaluation\FuncEvalDiagnostics.cs" Link="Evaluation\FuncEvalDiagnostics.cs" />
	<Compile Include="..\..\Extensions\dnSpy.Debugger\dnSpy.Debugger\Shared\Dispatcher.cs" Link="Debugger\Dispatcher.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Events\DebugEventBuffer.cs" Link="Events\DebugEventBuffer.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Events\EventCursorGuard.cs" Link="Events\EventCursorGuard.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Events\StateRevisionKinds.cs" Link="Events\StateRevisionKinds.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Events\OutputBuffer.cs" Link="Events\OutputBuffer.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Events\ProgramOutputAssembler.cs" Link="Events\ProgramOutputAssembler.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\ToolWindows\McpActivityLog.cs" Link="ToolWindows\McpActivityLog.cs" />
    <Compile Include="..\..\Extensions\dgSpy.Extension\Policy\CapabilityPolicy.cs" Link="Policy\CapabilityPolicy.cs" />
    <!-- BCL-only by construction: it resolves and verifies the shipped HookLab payload from the running
         host's own tree, so it can be exercised here against real packed, Gateway-deployed and worktree
         layouts rather than a stand-in for any of them. -->
    <Compile Include="..\..\Extensions\dgSpy.Extension\HookLab\HookLabPayloadResolver.cs" Link="HookLab\HookLabPayloadResolver.cs" />
    <ProjectReference Include="..\..\dgSpy.Protocol\dgSpy.Protocol.csproj" />
    <ProjectReference Include="..\..\HookLab\HookLab.Contracts\HookLab.Contracts.csproj" />
  </ItemGroup>
</Project>
